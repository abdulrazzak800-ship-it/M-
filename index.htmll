
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Une surprise ❤️</title>

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  background: black;
  overflow: hidden;
  height: 100vh;
  font-family: Arial, sans-serif;
}

canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.container {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  width: 100%;
  padding: 15px;
}

button {
  background: transparent;
  border: 2px solid #ff1680;
  color: #ff4b96;
  padding: 18px 35px;
  font-size: 25px;
  font-weight: bold;
  border-radius: 50px;
  cursor: pointer;
  box-shadow: 0 0 15px #ff1680,
              0 0 35px #ff1680;
  animation: pulse 1.2s infinite alternate;
}

button:hover {
  background: #ff1680;
  color: white;
}

h1 {
  display: none;
  color: #ff4b96;
  font-size: clamp(35px, 9vw, 75px);
  text-shadow: 0 0 15px #ff1680,
               0 0 35px #ff1680;
  animation: appear 1.5s ease;
}

p {
  color: white;
  font-size: 22px;
  margin-top: 20px;
  text-shadow: 0 0 15px #ff1680;
}

@keyframes pulse {
  from { transform: scale(1); }
  to { transform: scale(1.08); }
}

@keyframes appear {
  from {
    opacity: 0;
    transform: scale(0.3);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}
</style>
</head>

<body>

<canvas id="matrix"></canvas>

<div class="container">
  <button id="click" onclick="surprise()">
    CLIQUE ICI ❤️
  </button>

  <div id="message">
    <h1>JE T’AIME ❤️</h1>
    <p>Tu es la plus belle chose de ma vie 💕</p>
  </div>
</div>

<script>
const canvas = document.getElementById("matrix");
const ctx = canvas.getContext("2d");

let width, height, drops;
const size = 13;

function resize() {
  canvas.width = width = window.innerWidth;
  canvas.height = height = window.innerHeight;
  drops = Array(Math.floor(width / size)).fill(1);
}

window.addEventListener("resize", resize);
resize();

const letters = "JE T'AIME LOVE ♥ 01";

function draw() {
  ctx.fillStyle = "rgba(0,0,0,0.12)";
  ctx.fillRect(0, 0, width, height);

  ctx.fillStyle = "#ff287f";
  ctx.font = size + "px monospace";

  drops.forEach((y, i) => {
    const letter = letters[
      Math.floor(Math.random() * letters.length)
    ];

    ctx.fillText(letter, i * size, y * size);

    if (y * size > height && Math.random() > 0.97) {
      drops[i] = 0;
    }

    drops[i]++;
  });
}

setInterval(draw, 45);

function surprise() {
  document.getElementById("click").style.display = "none";
  document.querySelector("#message h1").style.display = "block";
  document.querySelector("#message p").style.display = "block";
}
</script>

</body>
</html>
